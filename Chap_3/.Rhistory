DF$mid = as.vector(apply(E_tirzz, MARGIN=c(1,2,4,5), FUN=quantile, prob=0.5, na.rm=TRUE))
ggplot(na.omit(DF)) +
geom_ribbon( aes(ymin=min, ymax=max, x=Year, fill=Model), alpha=0.4 ) +
geom_line( aes(y=mid, x=Year, color=Model), lwd=1 ) +
facet_grid2( c("Taxa","Param"), scales="free", independent="y", remove_labels="x" ) +
geom_hline( aes(yintercept=0) ) +
scale_y_continuous( name = "Error (10% to 90% range)" ) +
scale_x_discrete( name = "Year", breaks = scales::pretty_breaks(n = 3) )
